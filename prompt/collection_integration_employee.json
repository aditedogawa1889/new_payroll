{
    "info": {
        "_postman_id": "0bb5d7b5-e2ef-48b9-8a8a-f56d10f9b105",
        "name": "HRIS Payroll Integration API",
        "description": "Kumpulan API untuk integrasi data karyawan dari HRIS ke sistem Payroll.\n\nCara penggunaan:\n1. Jalankan request '0. Login' untuk mendapatkan api_token\n2. Token akan otomatis tersimpan ke variable {{token}}\n3. Semua request lain akan menggunakan {{token}} secara otomatis",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "0. Login",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "var jsonData = pm.response.json();",
                            "if (jsonData && jsonData.api_token) {",
                            "    pm.collectionVariables.set('token', jsonData.api_token);",
                            "    console.log('api_token berhasil disimpan: ' + jsonData.api_token);",
                            "} else {",
                            "    console.log('Login gagal atau api_token tidak ditemukan');",
                            "}"
                        ]
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json",
                        "type": "text"
                    },
                    {
                        "key": "Content-Type",
                        "value": "application/json",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"login\": \"admin@payroll.com\",\n    \"password\": \"password\"\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": "{{base_url}}/api/login",
                "description": "Login menggunakan email atau username dan password.\nSetelah berhasil, api_token akan otomatis disimpan ke variabel {{token}}.\n\nContoh akun:\n- admin@payroll.com / password\n- payroll@payroll.com / password"
            },
            "response": []
        },
        {
            "name": "1. Get Integration Types",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json",
                        "type": "text"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}",
                        "type": "text"
                    }
                ],
                "url": "{{base_url}}/api/hris/types",
                "description": "Mengambil daftar tipe integrasi yang tersedia dari tabel master_integration_types.\n\nResponse berisi list tipe:\n- 1: new employee\n- 2: update employee\n- 3: termination employee\n- 4: promotion employee"
            },
            "response": []
        },
        {
            "name": "2. Post New Employee",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json",
                        "type": "text"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}",
                        "type": "text"
                    },
                    {
                        "key": "Content-Type",
                        "value": "application/json",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"id_integ_type\": 1,\n    \"emp_number\": 2026001,\n    \"employee_id\": \"EMP-2026-001\",\n    \"employee_name\": \"John Doe\",\n    \"email\": \"johndoe@example.com\",\n    \"job_title_name\": \"Junior Developer\",\n    \"job_title_future_name\": null,\n    \"job_title_effective_date\": \"2026-01-01\",\n    \"job_level\": \"Staff\",\n    \"join_date\": \"2026-01-01\",\n    \"location_from_name\": \"Head Office\",\n    \"location_to_name\": \"Head Office\",\n    \"effective_year\": \"2026\",\n    \"termination_date\": null,\n    \"last_payroll_date\": null,\n    \"npwp\": \"12.345.678.9-012.000\",\n    \"bpjs_kesehatan\": \"0001234567890\",\n    \"bpjs_ketenagakerjaan\": \"98765432100\",\n    \"ktp\": \"3171012345670001\",\n    \"gender\": \"Male\",\n    \"bank_account\": \"1234567890\",\n    \"bank_name\": \"BCA\",\n    \"bank_account_name\": \"John Doe\"\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": "{{base_url}}/api/hris/integrations",
                "description": "Mendaftarkan karyawan baru ke sistem (id_integ_type: 1).\n\nField wajib: id_integ_type, emp_number, employee_id, job_title_name, join_date, location_from_name, location_to_name, job_title_effective_date"
            },
            "response": []
        },
        {
            "name": "3. Post Promotion",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json",
                        "type": "text"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}",
                        "type": "text"
                    },
                    {
                        "key": "Content-Type",
                        "value": "application/json",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"id_integ_type\": 4,\n    \"emp_number\": 2026001,\n    \"employee_id\": \"EMP-2026-001\",\n    \"job_title_name\": \"Junior Developer\",\n    \"job_title_future_name\": \"Software Engineer\",\n    \"job_title_effective_date\": \"2026-06-01\",\n    \"join_date\": \"2026-01-01\",\n    \"location_from_name\": \"Head Office\",\n    \"location_to_name\": \"Head Office\",\n    \"effective_year\": \"2026\",\n    \"termination_date\": null,\n    \"last_payroll_date\": null\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": "{{base_url}}/api/hris/integrations",
                "description": "Promosi karyawan (id_integ_type: 4).\n\njob_title_name = jabatan lama\njob_title_future_name = jabatan baru setelah promosi\njob_title_effective_date = tanggal efektif promosi"
            },
            "response": []
        },
        {
            "name": "4. Post Termination",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json",
                        "type": "text"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}",
                        "type": "text"
                    },
                    {
                        "key": "Content-Type",
                        "value": "application/json",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"id_integ_type\": 3,\n    \"emp_number\": 2026001,\n    \"employee_id\": \"EMP-2026-001\",\n    \"job_title_name\": \"Software Engineer\",\n    \"job_title_future_name\": null,\n    \"job_title_effective_date\": \"2026-12-31\",\n    \"join_date\": \"2026-01-01\",\n    \"location_from_name\": \"Head Office\",\n    \"location_to_name\": \"Head Office\",\n    \"effective_year\": \"2026\",\n    \"termination_date\": \"2026-12-31\",\n    \"last_payroll_date\": \"2026-12-25\"\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": "{{base_url}}/api/hris/integrations",
                "description": "Pemutusan hubungan kerja / resign karyawan (id_integ_type: 3).\n\ntermination_date = tanggal PHK/resign\nlast_payroll_date = tanggal gaji terakhir dibayarkan"
            },
            "response": []
        },
        {
            "name": "5. Post Summary Attendance",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json",
                        "type": "text"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}",
                        "type": "text"
                    },
                    {
                        "key": "Content-Type",
                        "value": "application/json",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"employee_id\": 2026001,\n    \"period_st\": \"2026-06-01\",\n    \"period_en\": \"2026-06-30\",\n    \"payroll_date\": \"2026-06-25\",\n    \"attendance_days\": 21.5\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": "{{base_url}}/api/integrations/attendance",
                "description": "Mengirimkan data rekapitulasi kehadiran (summary attendance) dari sistem absensi ke sistem payroll."
            },
            "response": []
        },
        {
            "name": "6. Post Summary Overtime",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json",
                        "type": "text"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}",
                        "type": "text"
                    },
                    {
                        "key": "Content-Type",
                        "value": "application/json",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"employee_id\": 2026001,\n    \"period_ot_st\": \"2026-06-01\",\n    \"period_ot_en\": \"2026-06-30\",\n    \"payroll_ot_date\": \"2026-06-25\",\n    \"overtime_hours\": 15.5,\n    \"overtime_meals\": 4\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": "{{base_url}}/api/integrations/overtime",
                "description": "Mengirimkan data rekapitulasi lembur (summary overtime) dari sistem lembur ke sistem payroll."
            },
            "response": []
        }
    ],
    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost/new_payroll/public",
            "type": "string"
        },
        {
            "key": "token",
            "value": "",
            "type": "string"
        }
    ]
}